with "../adacord.gpr";

project Ping_Bot is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/examples/ping_bot";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";
   for Main use ("ping_bot.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatW8", "-gnatVa");
   end Compiler;

end Ping_Bot;
